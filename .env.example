DATABASE_URL=postgresql://dotas:dotas_dev_only@db:5432/dotas_core
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional alert integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SOCKS5h endpoint. DotasPlus does not bundle or start Tor.
TOR_PROXY_URL=

# Exact hosts or parent domains approved for collection, comma-separated.
SOURCE_HOST_ALLOWLIST=fixture,localhost,127.0.0.1
